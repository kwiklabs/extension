{
  "manifest_version": 3,
  "name": "Kwik Send",
  "version": "0.1.0",
  "description": "Secure zero-knowledge file sharing from your browser",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.global.js"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "notifications"
  ],
  "host_permissions": [
    "https://kwik.gg/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
